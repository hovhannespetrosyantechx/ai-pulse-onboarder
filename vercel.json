{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "cd server && npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server/src/index.ts" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "functions": {
    "server/src/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
